{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pages/index.html",
      "destination": "https://medcompara.com.mx/medicamentos",
      "permanent": true
    },
    {
      "source": "/blog/:slug.html",
      "destination": "https://medcompara.com.mx/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "https://medcompara.com.mx/blog",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "https://medcompara.com.mx/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "https://medcompara.com.mx/blog/:slug",
      "permanent": true
    },
    {
      "source": "/pages/:slug.html",
      "destination": "https://medcompara.com.mx/:slug",
      "permanent": true
    },
    {
      "source": "/farmacias",
      "destination": "https://medcompara.com.mx/farmacias",
      "permanent": true
    },
    {
      "source": "/aviso-de-privacidad",
      "destination": "https://medcompara.com.mx/aviso-de-privacidad",
      "permanent": true
    },
    {
      "source": "/images/:file*",
      "destination": "https://medcompara.com.mx/images/:file*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://medcompara.com.mx/medicamentos",
      "permanent": true
    }
  ]
}
